generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  MONOBANK
}

enum OptionType {
  SIZE
  COLOR
  GEMSTONE
  PENDANT
}

enum Material {
  NATURAL_PEARLS    @map("натуральні перли")
  AMAZONITE         @map("амазоніт")
  MOUNTAIN_CRYSTAL  @map("гірський кришталь")
  ROSE_QUARTZ       @map("рожевий кварц")
  STRAWBERRY_QUARTZ @map("полуничний кварц")
  YELLOW_JADE       @map("жовтий нефрит")
  GREEN_CHALCEDONY  @map("зелений халцедон")
  CORAL_JADE        @map("кораловий нефрит")
  LILAC_CHALCEDONY  @map("бузковий халцедон")
  METAL_CHAIN       @map("металевий ланцюг")
  MINT_JADE         @map("мʼятний нефрит")
  CAIRO_NIGHT       @map("ніч каїра")
}

enum ProductType {
  HALVES               @map("Половинки")
  READY_COMBINATIONS   @map("Готові поєднання")
  CAPSULES             @map("Капсули")
}

enum BuilderPartKind {
  LEFT_HALF
  RIGHT_HALF
  PENDANT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String?
  name         String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
  builderParts BuilderPart[]
}

model Collection {
  id               String              @id @default(uuid())
  name             String              @unique
  slug             String              @unique
  imageUrl         String?
  supportsBuilder  Boolean             @default(false)
  products         ProductCollection[]
  builderParts     BuilderPart[]
}

model Product {
  id                String       @id @default(uuid())
  title             String
  description       String?
  productType       ProductType?
  materials         Material[]   @default([])
  materialText      String?    @map("material")
  jewelryLengthText String?    @map("jewelryLength")
  slug              String     @unique
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  price       Int      @default(0)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category           @relation(fields: [categoryId], references: [id])
  options     ProductOption[]
  images      ProductImage[]
  collections ProductCollection[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([slug])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductOption {
  id        String     @id @default(uuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      OptionType
  value     String

  @@unique([productId, type, value])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model Order {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod  @default(COD)
  monoInvoiceId   String?        @unique
  paidAt          DateTime?
  totalInCents    Int
  shippingName       String
  shippingCity       String
  shippingPostOffice String
  trackingNumber  String?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  quantity             Int
  price                Int
  size                 String?
  material             String?
  gemstone             String?
  pendant              String?
  builderPartIds       String[] @default([])
  builderSnapshotUrl   String?
  customLineTitle      String?

  @@index([orderId])
}

model BuilderPart {
  id               String          @id @default(uuid())
  title            String
  previewImageUrl  String
  selectorImageUrl String
  price            Int?
  kind             BuilderPartKind
  sortOrder        Int             @default(0)
  collectionId     String
  categoryId       String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([collectionId, categoryId, kind])
}
